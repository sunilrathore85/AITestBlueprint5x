{
  "installCommand": "npm install && npm run install:all",
  "buildCommand": "npm run build --prefix src/frontend",
  "outputDirectory": "src/frontend/dist",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    }
  }
}